# VeilBridge — Firebase AI Logic Configuration Template
# Never commit real API keys, App Check debug tokens, or .env files to Git!
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-v3-site-key
# Local development only (never enable in production):
VITE_USE_APPCHECK_DEBUG=false
